flowchart TD
  ai_intake["Зафиксировать область восстановления"]
  ai_intake -->|on_success| command_inventory
  command_inventory["Снимок репозиториев и текущих документов"]
  command_inventory -->|on_success| ai_bootstrap
  command_inventory -->|on_blocked| terminal_blocked
  ai_bootstrap["Восстановить as-is и происхождение знаний"]
  ai_bootstrap -->|on_success| ai_baseline_review
  ai_bootstrap -->|on_blocked| terminal_blocked
  ai_baseline_review["Независимая проверка recovered baseline"]
  ai_baseline_review -->|on_success| command_baseline_check
  ai_baseline_review -->|on_rework| ai_bootstrap
  ai_baseline_review -->|on_blocked| terminal_blocked
  command_baseline_check["Валидировать baseline и неизменность входов"]
  command_baseline_check -->|on_success| human_baseline
  command_baseline_check -->|on_blocked| terminal_blocked
  command_baseline_check -->|on_rework| ai_bootstrap
  human_baseline["Принять базу знаний, сохранив неизвестное"]
  human_baseline -->|on_approve| command_baseline_seal
  human_baseline -->|on_rework| ai_bootstrap
  command_baseline_seal["Подготовить принятую базу в pdlc/product"]
  command_baseline_seal -->|on_success| terminal_baseline
  command_baseline_seal -->|on_blocked| terminal_blocked
  terminal_baseline["Baseline prepared — документы не merged"]
  terminal_blocked["Blocked — база не принята"]
