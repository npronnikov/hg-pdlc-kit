{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "components",
  "type": "object",
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9-]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "repo_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9-]*$"
            }
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "type",
          "responsibility",
          "repo_paths",
          "dependencies",
          "interfaces"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "change_id",
    "components"
  ],
  "additionalProperties": false
}
