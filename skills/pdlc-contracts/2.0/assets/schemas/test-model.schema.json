{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg-pdlc:2.0:test-model",
  "title": "test-model",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "boundary": {
      "enum": [
        "browser",
        "api",
        "cli"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(INT|HYP|BR|AC|ADR|FR|NFR|CONTRACT|STORY|CODE|E2E|CHECK)-[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "kind": {
            "enum": [
              "e2e",
              "check"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(INT|HYP|BR|AC|ADR|FR|NFR|CONTRACT|STORY|CODE|E2E|CHECK)-[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(INT|HYP|BR|AC|ADR|FR|NFR|CONTRACT|STORY|CODE|E2E|CHECK)-[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "data_strategy": {
            "type": "string",
            "minLength": 1
          },
          "external_doubles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "mandatory": {
            "const": true
          }
        },
        "required": [
          "id",
          "kind",
          "priority",
          "requirements",
          "acceptance",
          "given",
          "when",
          "then",
          "data_strategy",
          "external_doubles",
          "mandatory"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "boundary",
    "tests"
  ],
  "additionalProperties": false
}
