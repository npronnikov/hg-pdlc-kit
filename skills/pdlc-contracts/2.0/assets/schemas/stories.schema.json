{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg-pdlc:2.0:stories",
  "title": "stories",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "goal"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(INT|HYP|BR|AC|ADR|FR|NFR|CONTRACT|STORY|CODE|E2E|CHECK)-[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "epic": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(INT|HYP|BR|AC|ADR|FR|NFR|CONTRACT|STORY|CODE|E2E|CHECK)-[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(INT|HYP|BR|AC|ADR|FR|NFR|CONTRACT|STORY|CODE|E2E|CHECK)-[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(INT|HYP|BR|AC|ADR|FR|NFR|CONTRACT|STORY|CODE|E2E|CHECK)-[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          },
          "repositories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "definition_of_done": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "epic",
          "title",
          "requirements",
          "acceptance",
          "depends_on",
          "repositories",
          "tasks",
          "definition_of_done"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "epics",
    "stories"
  ],
  "additionalProperties": false
}
