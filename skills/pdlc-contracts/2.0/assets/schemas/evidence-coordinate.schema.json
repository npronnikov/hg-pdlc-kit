{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg-pdlc:2.0:evidence-coordinate",
  "title": "evidence-coordinate",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "run_id",
    "node_id",
    "attempt",
    "path",
    "sha256"
  ],
  "additionalProperties": false
}
