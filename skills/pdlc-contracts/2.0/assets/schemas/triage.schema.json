{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg-pdlc:2.0:triage",
  "title": "triage",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "failed_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "root_cause_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "category": {
      "enum": [
        "implementation_defect",
        "test_harness_defect",
        "specification_gap",
        "architecture_gap",
        "intent_gap",
        "environment_blocked",
        "unknown"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "run_id",
          "node_id",
          "attempt",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "impacted_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "invalidate": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "return_node": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "needs_human": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "failed_ids",
    "root_cause_ids",
    "category",
    "evidence_refs",
    "impacted_ids",
    "invalidate",
    "return_node",
    "rationale",
    "needs_human"
  ],
  "additionalProperties": false
}
