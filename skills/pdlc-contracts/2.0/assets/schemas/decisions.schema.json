{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg-pdlc:2.0:decisions",
  "title": "decisions",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "unresolved_blocking": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "decision",
          "source",
          "authority"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "risk_level",
    "unresolved_blocking",
    "decisions"
  ],
  "additionalProperties": false
}
