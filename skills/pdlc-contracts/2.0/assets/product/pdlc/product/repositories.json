{
  "schema_version": "2.0",
  "docs_repo": "product",
  "repositories": [
    {
      "id": "product",
      "path": ".",
      "source_globs": [
        "src/**",
        "tests/**",
        "package.json",
        "package-lock.json",
        "pyproject.toml",
        "requirements*.txt",
        "go.mod",
        "go.sum",
        "pom.xml",
        "build.gradle*",
        "settings.gradle*",
        "backend/**",
        "frontend/**"
      ],
      "exclude_globs": [
        "**/node_modules/**",
        "**/build/**",
        "**/dist/**",
        "**/__pycache__/**",
        "**/.env*",
        "**/test-results/**",
        "**/playwright-report/**"
      ]
    }
  ]
}
